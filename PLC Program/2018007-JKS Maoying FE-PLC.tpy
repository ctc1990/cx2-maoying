				<Name FbParameter="Input">ARiUldStnID</Name>
				<Type Decoration="200100EF">ARRAY [1..1] OF INT</Type>
				<Comment>
					<![CDATA[To Define Unloading Station ID]]>
				</Comment>
				<BitSize>16</BitSize>
